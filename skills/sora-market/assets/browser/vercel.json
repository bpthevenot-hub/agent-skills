{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"cleanUrls": false,
	"rewrites": [
		{
			"source": "/",
			"destination": "/index.html"
		}
	],
	"headers": [
		{
			"source": "/products.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=60, stale-while-revalidate=300"
				}
			]
		}
	]
}
